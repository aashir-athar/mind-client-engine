    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "imapflow": "^1.3.4",
    "mailparser": "^3.9.9",
    "next": "^16.2.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
