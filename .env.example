# ============================================================
#  MiND Client Engine — environment template
#  Copy this file to .env.local and fill in YOUR values.
#  - .env       (committed)   : safe non-secret defaults
#  - .env.local (git-ignored) : your secrets, overrides .env
#  Both the Next.js app and the worker read these (worker via @next/env).
# ============================================================

# ---- Core ----
DATABASE_URL="file:./prisma/dev.db"
# DRY_RUN=true  => nothing is actually sent (default & safe).
# DRY_RUN=false => real cold email goes out (respecting caps + send window).
DRY_RUN="true"
# A descriptive User-Agent is REQUIRED to stay unblocked on free public APIs.
# IMPORTANT: OSM/Nominatim block fake "example.com" contacts — use a real URL/email.
USER_AGENT="MiNDClientEngine/0.1 (+https://github.com/mind-client-engine)"

# ---- LLM (local & free via Ollama) ----
LLM_PROVIDER="ollama"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# ---- Email / SMTP (Nodemailer) — used only when DRY_RUN=false (Phase 7) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Your Name <you@example.com>"
# Hard safety limits for cold email:
EMAIL_DAILY_CAP="20"
SEND_WINDOW_START="9"
SEND_WINDOW_END="18"

# ---- IMAP (optional reply detection — Phase 9) ----
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""

# ---- Reddit API (optional lead source — free 'script' app, Phase 5) ----
# User-Agent format MUST be: <platform>:<appid>:<version> (by /u/<username>)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_USER_AGENT="web:mind-client-engine:0.1 (by /u/yourname)"

# ---- Website auditor (Phase 3) ----
# Per-page fetch timeout (ms).
AUDIT_TIMEOUT_MS="12000"
# Google PageSpeed Insights (optional). When empty, PageSpeed is skipped and the
# four core checks still run with zero APIs. A free key adds the performance score.
PSI_KEY=""

# ---- Goal tracker ----
GOAL_TARGET_USD="10000"
GOAL_DEADLINE="2027-09-30"
