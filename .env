# ============================================================
#  MiND Client Engine — committed NON-SECRET defaults
#  Real secrets (SMTP/IMAP/Reddit passwords) go in .env.local
#  which is git-ignored. .env.local overrides values here.
# ============================================================

# Relative SQLite path — ALWAYS run the app and worker from the project root
# so this resolves to the same database file.
DATABASE_URL="file:./prisma/dev.db"

# SAFETY: DRY_RUN=true means NOTHING is actually sent. Sends are logged to the
# console and written to the AuditLog table instead. This is the dev default so
# your email reputation is never touched while testing. Set false only to go live.
DRY_RUN="true"

# Polite identification for all outbound public-data fetches (OSM / Reddit / RSS / site audit).
# NOTE: Nominatim/OSM block fake "example.com" contacts. Use a real URL or email
# (or leave this as-is). Adding your real contact is recommended for heavier use.
USER_AGENT="MiNDClientEngine/0.1 (+https://github.com/mind-client-engine)"

# ---- LLM (local & free via Ollama). Provider is pluggable in src/lib/llm.ts ----
LLM_PROVIDER="ollama"
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# ---- Email engine (Phase 7). SMTP_* go in .env.local; only used when DRY_RUN=false ----
EMAIL_DAILY_CAP="20"
SEND_WINDOW_START="9"
SEND_WINDOW_END="18"

# ---- Goal tracker (computed dynamically against today's date) ----
GOAL_TARGET_USD="10000"
GOAL_DEADLINE="2027-09-30"
